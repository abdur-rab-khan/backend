											},
											"content": [
												{
													"type": "text",
													"text": "Suppose I have thousand of images, and want to process using node.js, I know what you are thinking right now."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Node.js is single threaded If I do directly it will many the whole node.js too busy it can't handle other request because process and \"callstack\" is filled with \"image processing function\"."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Than what's the solution that, If you think I need to free my \"main js thread\", For this somehow we need to spawn some more thread so that my \"main js thread\" won't be busy."
												}
											]
										}
									]
								}
							]
						}
					]
				}
